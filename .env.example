# Docker Environment Configuration EXAMPLE
# Copy this to .env and modify as needed

# MySQL Configuration
MYSQL_ROOT_PASSWORD=Test@123
MYSQL_DATABASE=bankappdb
MYSQL_USER=bankapp
MYSQL_PASSWORD=BankApp@123

# Spring Boot Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://mysql-db:3306/bankappdb?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=bankapp
SPRING_DATASOURCE_PASSWORD=BankApp@123
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_PROFILES_ACTIVE=docker

# Application
SPRING_APPLICATION_NAME=bankapp
SERVER_PORT=8080

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_EXAMPLE_BANKAPP=DEBUG

